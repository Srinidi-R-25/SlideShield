# Backend Environment Variables

# JWT Secret Key (generate a random 32-char string for production)
SECRET_KEY=slideshield-super-secret-jwt-key-2026-production-secure

# Database URL (SQLite default for local development)
DATABASE_URL=sqlite:///./slideshield.db

# For Neon PostgreSQL Production (uncomment and fill in):
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Google Gemini AI API Key (optional - realistic fallback works without it)
GEMINI_API_KEY=

# CORS - Comma-separated list of allowed frontend origins
# Default: localhost:3000 for local dev. Add your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# ALLOWED_ORIGINS=https://slideshield.vercel.app,http://localhost:3000

# Cloudinary (optional - for image CDN in production)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
